{
  "permissions": {
    "deny": [
      "Read(./test/fixtures/corpus/**)",
      "Edit(./test/fixtures/corpus/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat ./test/fixtures/corpus/*)",
      "Bash(cat ./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-untrusted.mjs"
          }
        ]
      }
    ]
  }
}
